{
  "layer": "top",
  "position": "top",
  "height": 29,
  "spacing": 8,

  "modules-left": [
    "custom/arch",
    "ext/workspaces",
    "custom/window"
  ],

  "modules-center": [
    "custom/cpu",
    "custom/sep#1",
    "memory",
    "custom/sep#2",
    "custom/gpu"
  ],

  "modules-right": [
    "tray",
    "custom/notification",
    "network",
    "custom/brightness",
    "pulseaudio",
    "clock"
  ],

  // ---------- left ----------
  "custom/arch": {
    "format": "\uf303",
    "tooltip-format": "i use arch btw",
    "tooltip": true
  },

  "ext/workspaces": {
    "format": "{name}",
    "ignore-hidden": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true
  },

  "custom/window": {
    "exec": "~/.config/waybar/scripts/window.sh",
    "interval": 1,
    "max-length": 50,
    "escape": true,
    "tooltip": true
  },

  // ---------- center ----------
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/hw.sh cpu",
    "interval": 2,
    "tooltip": true 
  },

  "custom/sep#1": {
    "format": "│",
    "tooltip": false
  },

  "memory": {
    "format": "RAM {used:0.1f}GB/{total:0.1f}GB",
    "interval": 3,
    "tooltip": true
  },

  "custom/sep#2": {
    "format": "│",
    "tooltip": false
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/hw.sh gpu",
    "interval": 2,
    "tooltip": true 
  },

  // ---------- right ----------
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

"custom/notification": {
    "exec": "~/.config/waybar/scripts/mako-status.py",
    "return-type": "json",
    "interval": 2,
    "signal": 8,
    "tooltip": true,
    "on-click": "makoctl mode | grep -q do-not-disturb && makoctl mode -r do-not-disturb || makoctl mode -a do-not-disturb; pkill -RTMIN+8 waybar",
    "on-click-right": "makoctl dismiss -a; pkill -RTMIN+8 waybar",
    "on-click-middle": "makoctl restore"
},

  "network": {
    "format-wifi": "\uf1eb {essid}",
    "format-ethernet": "\uf0ac wired",
    "format-disconnected": "\uf071 offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "interval": 5,
    "on-click": "nm-connection-editor"
},
"custom/notification": {
    "exec": "~/.config/waybar/scripts/mako-status.py",
    "return-type": "json",
    "interval": 2,
    "signal": 8,
    "tooltip": true,
    "on-click": "pgrep -x rofi && pkill -x rofi || ~/.config/waybar/scripts/notif-center.py",
    "on-click-right": "makoctl mode | grep -q do-not-disturb && makoctl mode -r do-not-disturb || makoctl mode -a do-not-disturb; pkill -RTMIN+8 waybar",
    "on-click-middle": "makoctl dismiss -a; pkill -RTMIN+8 waybar"
},

  "pulseaudio": {
    "format": "\uf028 {volume}%",
    "format-muted": "\uf026 muted",
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "clock": {
    "format": "\uf017 {:%I:%M %p}",
    "tooltip-format": "{:%A, %d %B %Y}"
  }
}
