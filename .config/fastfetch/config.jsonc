{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2
        }
    },
    "display": {
        "separator": " -> "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": " {icon} OS",
            "keyColor": "blue"
        },
	{
            "type": "kernel",
            "key": " ├{icon}",
            "keyColor": "blue"
        },	
        {
            "type": "packages",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": " ├",
            "keyColor": "blue"
        },
        {
   	    "type": "disk",
  	    "folders": "/",
  	    "format": "{days} days",
  	    "key": " └",
  	    "keyColor": "blue"
        },
        "break",
        {
            "type": "wm",
            "key": "  DE/WM",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "wallpaper",
            "key": " └󰸉",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "host",
            "key": " 󰌢 PC",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": " ├{icon}",
            "keyColor": "blue",
            "format": "{cores-logical} x {name}"
        },
        {
            "type": "gpu",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "swap",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": " ├{icon}",
            "keyColor": "blue"
        },
	{
    	    "type": "localip",
    	    "key": " ├󱦂",
    	    "keyColor": "blue"
	},
        {
            "type": "display",
            "key": " └󰍹",
            "keyColor": "blue"
        },

        "break",
        "colors"

    ]
}
